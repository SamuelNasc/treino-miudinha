{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "types": ["vite/client", "vite-plugin-pwa/client", "@testing-library/jest-dom/vitest", "node"]
  },
  "include": ["src", "tests", "e2e", "playwright.config.ts", "vite.config.ts", "vitest.config.ts", "vitest.pwa.config.ts"]
}
